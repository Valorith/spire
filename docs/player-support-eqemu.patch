+static void SendSupportMoveResult(EQ::Net::ConsoleServerConnection *connection, const char *status, uint16 port = 0)
+{
+	connection->SendLine(fmt::format("{{\"status\":\"{}\",\"port\":{}}}", status, port));
+}
