+static uint16 SupportZonePort(ZoneServer *zone_server)
+{
+	if (!zone_server || (zone_server->GetIP() != "127.0.0.1" && zone_server->GetIP() != "::ffff:127.0.0.1")) {
+		return 0;
+	}
+	return zone_server->GetCPort();
+}
