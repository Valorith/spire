{
  "name": "spire",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:eqsage-embed": "npm --prefix eqsage-embed ci --ignore-scripts && npm --prefix eqsage-embed run build",
    "watch:eqsage-embed": "npm --prefix eqsage-embed ci --ignore-scripts && npm --prefix eqsage-embed run build:watch",
    "dev": "npm run build:eqsage-embed && cross-env NODE_OPTIONS=--openssl-legacy-provider node --max_old_space_size=4096 --stack-size=10000 node_modules/@vue/cli-service/bin/vue-cli-service.js serve --open --host=0.0.0.0",
    "serve": "npm run build:eqsage-embed && cross-env NODE_OPTIONS=--openssl-legacy-provider node --max_old_space_size=4096 --stack-size=10000 node_modules/@vue/cli-service/bin/vue-cli-service.js serve --host=0.0.0.0",
    "build:vue": "cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=production node --max_old_space_size=4096 --stack-size=10000 node_modules/@vue/cli-service/bin/vue-cli-service.js build --nomaps",
    "build": "npm run build:eqsage-embed && npm run build:vue && node scripts/sync-eqsage-embed.js",
    "lint": "vue-cli-service lint --no-fix --format stylish"
  },
  "dependencies": {
    "@exuanbo/file-icons-js": "^3.3.0",
    "@sentry/tracing": "^7.120.4",
    "@sentry/vue": "^7.120.4",
    "@types/jquery": "^3.5.9",
    "@types/leaflet": "^1.7.9",
    "ansi-to-html": "^0.7.2",
    "axios": "^0.18.0",
    "bootstrap": "^4.6.1",
    "bootstrap-vue": "^2.21.2",
    "browserslist": "^4.24.3",
    "caniuse-lite": "^1.0.30001690",
    "cheerio": "^1.0.0-rc.10",
    "core-js": "^2.6.12",
    "dayjs": "^1.11.13",
    "dot-object": "^2.1.4",
    "fontawesome-4.7": "^4.7.0",
    "highlight.js": "^9.18.3",
    "jquery": "^3.6.0",
    "leaflet": "^1.7.1",
    "markdown-it": "^12.2.0",
    "ninja-keys": "^1.2.2",
    "qs": "^6.5.2",
    "rpg-awesome": "^0.2.0",
    "semver": "^5.7.0",
    "slugify": "^1.6.3",
    "superagent": "^6.1.0",
    "toastify-js": "^1.12.0",
    "v-runtime-template": "^1.10.0",
    "vue": "^2.7.16",
    "vue-backtotop": "^1.6.1",
    "vue-class-component": "^7.2.6",
    "vue-color": "^2.8.1",
    "vue-property-decorator": "^8.5.1",
    "vue-router": "^3.5.3",
    "vue2-ace-editor": "^0.0.15",
    "vue2-dropzone": "^3.6.0",
    "vue2-leaflet": "^2.7.1",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "@vue/cli-plugin-babel": "^3.6.0",
    "@vue/cli-plugin-eslint": "3.12.1",
    "@vue/cli-plugin-typescript": "^3.6.0",
    "@vue/cli-service": "^3.6.0",
    "@vue/eslint-config-standard": "6.1.0",
    "@vue/eslint-config-typescript": "8.0.0",
    "babel-eslint": "^10.0.1",
    "cross-env": "^7.0.3",
    "eslint": "7.32.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-promise": "5.2.0",
    "eslint-plugin-vue": "7.20.0",
    "sass": "^1.44.0",
    "sass-loader": "^7.1.0",
    "typescript": "^4.4.4",
    "vue-template-compiler": "^2.6.14",
    "webpack-cli": "^4.9.2"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "@vue/standard",
      "@vue/typescript"
    ],
    "rules": {
      "indent": "off",
      "vue/script-indent": [
        "warn",
        2,
        {
          "baseIndent": 1
        }
      ]
    },
    "parserOptions": {
      "parser": "@typescript-eslint/parser"
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ]
}
